<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="Container" style="flex-direction: row; align-items: center; height: 20px; margin: 0 0 2px 0; padding: 0;">
        <!-- Usando a classe nativa do Unity para alinhar o label com o restante do Inspector -->
        <ui:Label text="Label" name="Label" class="unity-property-field__label" style="flex-grow: 0; flex-shrink: 0; width: 45%; -unity-text-align: middle-left;"/>        
        <ui:VisualElement name="ControlContainer" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-end;">
            <!-- Limite Mínimo: tamanho fixo, texto apagado e alinhado à direita -->
            <ui:Label text="0" name="LowLimit" enabled="false" style="width: 25px; margin-right: 4px; -unity-text-align: middle-right; opacity: 0.5;" />
            
            <!-- Input de Valor Mínimo: tamanho compacto e fixo -->
            <ui:FloatField value="10" name="LowValue" style="width: 45px; margin-right: 6px; height: 18px;" />
            
            <!-- Slider Principal: preenche o espaço restante de forma flexível -->
            <ui:MinMaxSlider value="10,12" low-limit="0" high-limit="40" name="MinMaxSlider" style="flex-grow: 1; margin-right: 6px;" />
            
            <!-- Input de Valor Máximo: tamanho compacto e fixo -->
            <ui:FloatField value="12" name="HighValue" style="width: 45px; margin-right: 4px; height: 18px;" />
            
            <!-- Limite Máximo: tamanho fixo, texto apagado e alinhado à esquerda -->
            <ui:Label text="40" name="HighLimit" enabled="false" style="width: 25px; -unity-text-align: middle-left; opacity: 0.5;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>